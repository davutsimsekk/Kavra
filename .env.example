# Bu dosyayi kopyalayip ".env" olarak yeniden adlandirin ve kendi anahtarlarinizi girin.
# .env dosyasi .gitignore'da oldugu icin GitHub'a asla yuklenmez.

# Google Gemini API anahtari (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI uyumlu saglayici anahtari (örn. OpenRouter: https://openrouter.ai/keys)
OPENAI_API_KEY=

# Opsiyonel: ElevenLabs bulut TTS
# ELEVENLABS_API_KEY=

# GPU'suz sunucuda (VPS) hafif Docker imajı: CUDA Torch/XTTS/Anka/Chatterbox kurulmaz.
# Ağır sesler uzak GPU'da çalışır (bkz. REMOTE_TTS.md). Varsayılan 1 = hepsi kurulur.
# KAVRA_LOCAL_TTS=0

# Docker Compose'un bilgisayarda açacağı port
KAVRA_PORT=8768

# Temiz Docker cache'inde Chatterbox ilk kullanımda model indirebilsin.
# Model bir kez indikten sonra 1 yaparak tamamen offline çalıştırabilirsiniz.
CHATTERBOX_HF_HUB_OFFLINE=0

# Sunucuda (örn. Tailscale üzerinden) alan adıyla açmak için; bkz. DOCKER.md §8.
# Joker (*) kabul edilmez. Origin verilmezse hostlardan http/https türetilir.
# KAVRA_ALLOWED_HOSTS=kavra.tailnet-adi.ts.net
# KAVRA_ALLOWED_ORIGINS=https://kavra.tailnet-adi.ts.net

# Normal (Docker dışı) kurulumda veriyi kod klasöründen ayırmak isterseniz:
# KAVRA_DATA_DIR=D:\KavraData
