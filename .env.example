# Bu dosyayi kopyalayip ".env" olarak yeniden adlandirin ve kendi anahtarlarinizi girin.
# .env dosyasi .gitignore'da oldugu icin GitHub'a asla yuklenmez.

# Google Gemini API anahtari (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI uyumlu saglayici anahtari (örn. OpenRouter: https://openrouter.ai/keys)
OPENAI_API_KEY=

# Opsiyonel: ElevenLabs bulut TTS
# ELEVENLABS_API_KEY=